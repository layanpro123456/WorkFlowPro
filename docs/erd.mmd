erDiagram
    AspNetUsers ||--o{ AspNetUserRoles : "has"
    AspNetRoles ||--o{ AspNetUserRoles : "assigned to"
    AspNetUsers ||--o{ refresh_tokens : "owns"
    AspNetUsers ||--o{ projects : "creates"
    AspNetUsers ||--o{ project_members : "participates in"
    projects ||--o{ project_members : "contains"
    projects ||--o{ tasks : "contains"
    AspNetUsers ||--o{ tasks : "assignee"
    tasks ||--o{ task_comments : "has"
    AspNetUsers ||--o{ task_comments : "author"
    tasks ||--o{ task_status_histories : "tracks"
    AspNetUsers ||--o{ task_status_histories : "changed by"

    AspNetUsers {
        uuid Id PK
        string DisplayName
        boolean IsActive
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        string Email
        string UserName
        string PasswordHash
        int AccessFailedCount
    }

    AspNetRoles {
        uuid Id PK
        string Name
        string NormalizedName
    }

    AspNetUserRoles {
        uuid UserId PK, FK
        uuid RoleId PK, FK
    }

    refresh_tokens {
        uuid Id PK
        uuid UserId FK
        string TokenHash UK
        timestamptz ExpiresAtUtc
        timestamptz RevokedAtUtc
        uuid ReplacedByTokenId
        string DeviceLabel
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    projects {
        uuid Id PK
        string ProjectCode UK
        string Name
        string Description
        string Status
        date StartDate
        date TargetDate
        uuid CreatedById FK
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        timestamptz ArchivedAtUtc
    }

    project_members {
        uuid ProjectId PK, FK
        uuid UserId PK, FK
        string ProjectRole
        timestamptz JoinedAtUtc
    }

    tasks {
        uuid Id PK
        uuid ProjectId FK
        string Title
        string Description
        string Status
        string Priority
        uuid AssigneeId FK
        uuid CreatedById FK
        timestamptz DueAtUtc
        int EstimateMinutes
        int Version
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    task_comments {
        uuid Id PK
        uuid TaskId FK
        uuid AuthorId FK
        string Body
        timestamptz CreatedAtUtc
    }

    task_status_histories {
        uuid Id PK
        uuid TaskId FK
        string FromStatus
        string ToStatus
        uuid ChangedById FK
        timestamptz ChangedAtUtc
        string Comment
    }
