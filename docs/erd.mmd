    AspNetUsers {
        uuid Id PK
        string DisplayName
        boolean IsActive
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        string Email
        string UserName
        string PasswordHash
        int AccessFailedCount
    }

    AspNetRoles {
        uuid Id PK
        string Name
        string NormalizedName
    }

    AspNetUserRoles {
        uuid UserId PK, FK
        uuid RoleId PK, FK
    }

    refresh_tokens {
        uuid Id PK
        uuid UserId FK
        string TokenHash UK
        timestamptz ExpiresAtUtc
        timestamptz RevokedAtUtc
        uuid ReplacedByTokenId
        string DeviceLabel
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    projects {
        uuid Id PK
        string ProjectCode UK
        string Name
        string Description
        string Status
        date StartDate
        date TargetDate
        uuid CreatedById FK
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        timestamptz ArchivedAtUtc
    }

    project_members {
        uuid ProjectId PK, FK
        uuid UserId PK, FK
        string ProjectRole
        timestamptz JoinedAtUtc
    }

    tasks {
        uuid Id PK
        uuid ProjectId FK
        string Title
        string Description
        string Status
        string Priority
        uuid AssigneeId FK
        uuid CreatedById FK
        timestamptz DueAtUtc
        int EstimateMinutes
        int Version
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    task_comments {
        uuid Id PK
        uuid TaskId FK
        uuid AuthorId FK
        string Body
        timestamptz CreatedAtUtc
    }

    task_status_histories {
        uuid Id PK
        uuid TaskId FK
        string FromStatus
        string ToStatus
        uuid ChangedById FK
        timestamptz ChangedAtUtc
        string Comment
    }

    support_tickets {
        uuid Id PK
        bigint TicketNumber UK
        uuid RequesterId FK
        uuid AssigneeId FK
        uuid RelatedProjectId FK
        string Subject
        string Description
        string Category
        string Priority
        string Status
        timestamptz ResolvedAtUtc
        timestamptz ClosedAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    ticket_messages {
        uuid Id PK
        uuid TicketId FK
        uuid AuthorId FK
        string Body
        boolean IsInternalNote
        timestamptz CreatedAtUtc
    }

    ticket_status_histories {
        uuid Id PK
        uuid TicketId FK
        string FromStatus
        string ToStatus
        uuid ChangedById FK
        timestamptz ChangedAtUtc
        string Comment
    }

    workflow_definitions {
        uuid Id PK
        string Name
        string Description
        boolean IsActive
        uuid CreatedById FK
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    workflow_steps {
        uuid Id PK
        uuid WorkflowDefinitionId FK
        int StepOrder
        string Name
        string ApproverRole
        uuid ApproverUserId FK
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    approval_requests {
        uuid Id PK
        bigint RequestNumber UK
        uuid WorkflowDefinitionId FK
        uuid RequesterId FK
        string Title
        string Description
        string Status
        int CurrentStepOrder
        int Version
        timestamptz SubmittedAtUtc
        timestamptz CompletedAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    approval_request_steps {
        uuid Id PK
        uuid ApprovalRequestId FK
        int StepOrder
        string Name
        uuid ApproverUserId FK
        string Status
        timestamptz DecidedAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    approval_decisions {
        uuid Id PK
        uuid ApprovalRequestStepId UK, FK
        uuid ApproverId FK
        string Decision
        string Comment
        timestamptz DecidedAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    notifications {
        uuid Id PK
        uuid RecipientId FK
        string Type
        string Title
        string Message
        string EntityType
        uuid EntityId
        timestamptz ReadAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    audit_logs {
        uuid Id PK
        uuid ActorId FK
        string Action
        string EntityType
        uuid EntityId
        timestamptz OccurredAtUtc
        string CorrelationId
        string Metadata
    }
