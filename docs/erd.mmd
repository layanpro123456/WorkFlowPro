erDiagram
    AspNetUsers ||--o{ AspNetUserRoles : "has"
    AspNetRoles ||--o{ AspNetUserRoles : "assigned to"
    AspNetUsers ||--o{ refresh_tokens : "owns"
    AspNetUsers ||--o{ projects : "creates"
    AspNetUsers ||--o{ project_members : "participates in"
    projects ||--o{ project_members : "contains"
    projects ||--o{ tasks : "contains"
    AspNetUsers ||--o{ tasks : "assignee"
    tasks ||--o{ task_comments : "has"
    AspNetUsers ||--o{ task_comments : "author"
    tasks ||--o{ task_status_histories : "tracks"
    AspNetUsers ||--o{ task_status_histories : "changed by"
    AspNetUsers ||--o{ support_tickets : "requester"
    AspNetUsers ||--o{ support_tickets : "assignee"
    projects ||--o{ support_tickets : "related project"
    support_tickets ||--o{ ticket_messages : "has"
    AspNetUsers ||--o{ ticket_messages : "author"
    support_tickets ||--o{ ticket_status_histories : "tracks"
    AspNetUsers ||--o{ ticket_status_histories : "changed by"

    AspNetUsers {
        uuid Id PK
        string DisplayName
        boolean IsActive
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        string Email
        string UserName
        string PasswordHash
        int AccessFailedCount
    }

    AspNetRoles {
        uuid Id PK
        string Name
        string NormalizedName
    }

    AspNetUserRoles {
        uuid UserId PK, FK
        uuid RoleId PK, FK
    }

    refresh_tokens {
        uuid Id PK
        uuid UserId FK
        string TokenHash UK
        timestamptz ExpiresAtUtc
        timestamptz RevokedAtUtc
        uuid ReplacedByTokenId
        string DeviceLabel
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    projects {
        uuid Id PK
        string ProjectCode UK
        string Name
        string Description
        string Status
        date StartDate
        date TargetDate
        uuid CreatedById FK
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
        timestamptz ArchivedAtUtc
    }

    project_members {
        uuid ProjectId PK, FK
        uuid UserId PK, FK
        string ProjectRole
        timestamptz JoinedAtUtc
    }

    tasks {
        uuid Id PK
        uuid ProjectId FK
        string Title
        string Description
        string Status
        string Priority
        uuid AssigneeId FK
        uuid CreatedById FK
        timestamptz DueAtUtc
        int EstimateMinutes
        int Version
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    task_comments {
        uuid Id PK
        uuid TaskId FK
        uuid AuthorId FK
        string Body
        timestamptz CreatedAtUtc
    }

    task_status_histories {
        uuid Id PK
        uuid TaskId FK
        string FromStatus
        string ToStatus
        uuid ChangedById FK
        timestamptz ChangedAtUtc
        string Comment
    }

    support_tickets {
        uuid Id PK
        bigint TicketNumber UK
        uuid RequesterId FK
        uuid AssigneeId FK
        uuid RelatedProjectId FK
        string Subject
        string Description
        string Category
        string Priority
        string Status
        timestamptz ResolvedAtUtc
        timestamptz ClosedAtUtc
        timestamptz CreatedAtUtc
        timestamptz UpdatedAtUtc
    }

    ticket_messages {
        uuid Id PK
        uuid TicketId FK
        uuid AuthorId FK
        string Body
        boolean IsInternalNote
        timestamptz CreatedAtUtc
    }

    ticket_status_histories {
        uuid Id PK
        uuid TicketId FK
        string FromStatus
        string ToStatus
        uuid ChangedById FK
        timestamptz ChangedAtUtc
        string Comment
    }
