# WorkFlowPro Environment Configuration Template
# Copy this file to .env and configure values for local or Docker Compose deployment.
# NEVER commit production passwords, signing keys, or credentials to version control.

# PostgreSQL Database Configuration
POSTGRES_DB=workflowpro
POSTGRES_USER=workflowpro_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY

# Database Connection String
# For local host development: Host=localhost;Port=5432;...
# For Docker Compose: Host=db;Port=5432;...
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=workflowpro;Username=workflowpro_app;Password=CHANGE_ME_LOCAL_DEV_ONLY

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Development
ApplyMigrationsAtStartup=true
SeedDemoData=true

# JWT Authentication
Jwt__Issuer=WorkFlowPro
Jwt__Audience=WorkFlowPro.Web
Jwt__SigningKey=REPLACE_WITH_A_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS!
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Allowed CORS Origins
AllowedOrigins__0=http://localhost:4200
AllowedOrigins__1=http://localhost:80
AllowedOrigins__2=http://localhost
